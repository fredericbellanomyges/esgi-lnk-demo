{
  "name": "esgi-lnk",
  "version": "1.0.0",
  "private": true,
  "description": "ESGI.lnk : un raccourcisseur d'URL, fil rouge du cours d'intégration continue",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test": "npm run test:unit && npm run test:integration",
    "build": "tsc -p tsconfig.build.json",
    "test:coverage": "vitest run --coverage",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "fastify": "5.12.8",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "26.6.7",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  }
}
